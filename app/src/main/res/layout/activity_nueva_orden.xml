<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo"
    tools:context=".NuevaOrdenActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/morado"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivVolver"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_volver"
            android:tint="@color/white"
            android:layout_marginEnd="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nueva Orden"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Tarjeta: cliente y fecha -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Cliente" android:textColor="@color/morado" android:textStyle="bold" android:textSize="13sp" />
                <Spinner
                    android:id="@+id/spinnerCliente"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Fecha" android:textColor="@color/morado" android:textStyle="bold" android:textSize="13sp" />
                <TextView
                    android:id="@+id/tvFecha"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="@color/texto"
                    android:textSize="16sp"
                    android:paddingTop="4dp" />

            </LinearLayout>

            <!-- Tarjeta: agregar producto -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginBottom="14dp">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Producto" android:textColor="@color/morado" android:textStyle="bold" android:textSize="13sp" />
                <Spinner
                    android:id="@+id/spinnerProducto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp" />

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Cantidad" android:textColor="@color/morado" android:textStyle="bold" android:textSize="13sp" />
                <EditText
                    android:id="@+id/etCantidad"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:hint="Ej: 2"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAgregarProducto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Agregar producto a la orden"
                    android:textColor="@color/white"
                    app:icon="@drawable/ic_mas"
                    app:iconTint="@color/white"
                    app:iconGravity="textStart"
                    app:backgroundTint="@color/verde"
                    app:cornerRadius="12dp" />

            </LinearLayout>

            <!-- Productos agregados -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Productos agregados"
                android:textColor="@color/texto"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:id="@+id/llItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- Total -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_card"
                android:padding="16dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Total de la orden"
                    android:textColor="@color/texto"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/tvTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="B/. 0.00"
                    android:textColor="@color/morado"
                    android:textStyle="bold"
                    android:textSize="20sp" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarOrden"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Guardar Orden"
                android:textColor="@color/white"
                app:icon="@drawable/ic_guardar"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:backgroundTint="@color/morado"
                app:cornerRadius="12dp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
